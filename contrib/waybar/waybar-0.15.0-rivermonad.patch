@@ -0,0 +1,148 @@
+#include "modules/rivermonad/workspaces.hpp"
+
+#include <gtkmm/label.h>
+#include <spdlog/spdlog.h>
+
+#include <vector>
+
+namespace waybar::modules::rivermonad {
+
+Workspaces::Workspaces(const std::string& id, const Bar& bar, const Json::Value& config)
+    : AModule(config, "workspaces", id, false, false), bar_(bar), box_(bar.orientation, 0) {
+  box_.set_name("workspaces");
+  if (!id.empty()) box_.get_style_context()->add_class(id);
+  box_.get_style_context()->add_class(MODULE_CLASS);
+  event_box_.add(box_);
+
+  if (!gIPC) gIPC = std::make_unique<IPC>();
+  gIPC->registerForIPC(this);
+
+  dp.emit();
+}
+
+Workspaces::~Workspaces() { gIPC->unregisterForIPC(this); }
+
+void Workspaces::onEvent() { dp.emit(); }
+
+static void setClass(const Glib::RefPtr<Gtk::StyleContext>& ctx, const char* cls, bool on) {
+  if (on)
+    ctx->add_class(cls);
+  else
+    ctx->remove_class(cls);
+}
+
+void Workspaces::doUpdate() {
+  auto ipcLock = gIPC->lockData();
+  const auto& state = gIPC->state();
+
+  const auto showExtra = config_["show-extra"].asBool();
+  const auto hideEmpty = config_["hide-empty"].asBool();
+  const auto& myOutput = bar_.output->name;
+
+  // Workspaces to show, in rivermonad's order (configuration order).
+  std::vector<Json::Value> shown;
+  if (gIPC->connected()) {
+    for (const auto& ws : state["workspaces"]) {
+      if (ws["extra"].asBool() && !showExtra) continue;
+      const bool empty = ws["windows"].asUInt() == 0;
+      if (hideEmpty && empty && !ws["focused"].asBool() && !ws["visible"].asBool()) continue;
+      shown.push_back(ws);
+    }
+  }
+
+  // Remove buttons for workspaces that are no longer shown.
+  for (auto it = buttons_.begin(); it != buttons_.end();) {
+    const auto& name = it->first;
+    const bool keep = std::any_of(shown.begin(), shown.end(),
+                                  [&](const auto& ws) { return ws["name"].asString() == name; });
+    if (keep) {
+      ++it;
+    } else {
+      box_.remove(it->second);
+      it = buttons_.erase(it);
+    }
+  }
+
+  int pos = 0;
+  for (const auto& ws : shown) {
+    const auto name = ws["name"].asString();
+    auto bit = buttons_.find(name);
+    auto& button = bit == buttons_.end() ? addButton(name) : bit->second;
+    auto ctx = button.get_style_context();
+
+    const bool onThisOutput = !ws["output"].isNull() && ws["output"].asString() == myOutput;
+    // "focused": the workspace with keyboard focus (xmonad's current one).
+    setClass(ctx, "focused", ws["focused"].asBool());
+    // "active": the workspace shown on this bar's output.
+    setClass(ctx, "active", onThisOutput);
+    // "visible": shown on some output (xmonad's ppVisible).
+    setClass(ctx, "visible", ws["visible"].asBool());
+    setClass(ctx, "empty", ws["windows"].asUInt() == 0);
+
+    button.set_name("rivermonad-workspace-" + name);
+
+    std::string label = name;
+    if (config_["format"].isString()) {
+      label = fmt::format(fmt::runtime(config_["format"].asString()),
+                          fmt::arg("icon", getIcon(name, ws)), fmt::arg("value", name),
+                          fmt::arg("name", name), fmt::arg("index", ws["idx"].asUInt()),
+                          fmt::arg("windows", ws["windows"].asUInt()),
+                          fmt::arg("layout", ws["layout"].asString()),
+                          fmt::arg("output", ws["output"].isNull() ? "" : ws["output"].asString()));
+    }
+    if (!config_["disable-markup"].asBool()) {
+      static_cast<Gtk::Label*>(button.get_children()[0])->set_markup(label);
+    } else {
+      button.set_label(label);
+    }
+
+    if (config_["current-only"].asBool() && !onThisOutput)
+      button.hide();
+    else
+      button.show();
+
+    box_.reorder_child(button, pos++);
+  }
+}
+
+void Workspaces::update() {
+  doUpdate();
+  AModule::update();
+}
+
+Gtk::Button& Workspaces::addButton(const std::string& name) {
+  auto pair = buttons_.emplace(name, name);
+  auto& button = pair.first->second;
+  box_.pack_start(button, false, false, 0);
+  button.set_relief(Gtk::RELIEF_NONE);
+  if (!config_["disable-click"].asBool()) {
+    // "focus" (default) is xmonad's view: a workspace visible on another
+    // monitor gets the focus there. "view" is greedyView: bring it here.
+    const auto action =
+        config_["click-action"].asString() == "view" ? "ViewWorkspace" : "FocusWorkspace";
+    button.signal_pressed().connect([name, action] {
+      try {
+        Json::Value request(Json::objectValue);
+        request["Action"][action] = name;
+        IPC::send(request);
+      } catch (const std::exception& e) {
+        spdlog::error("rivermonad: error switching workspace: {}", e.what());
+      }
+    });
+  }
+  return button;
+}
+
+std::string Workspaces::getIcon(const std::string& name, const Json::Value& ws) {
+  const auto& icons = config_["format-icons"];
+  if (!icons) return name;
+  // Same precedence as niri/workspaces: state first, then the name.
+  if (ws["windows"].asUInt() == 0 && icons["empty"]) return icons["empty"].asString();
+  if (ws["focused"].asBool() && icons["focused"]) return icons["focused"].asString();
+  if (ws["visible"].asBool() && icons["visible"]) return icons["visible"].asString();
+  if (icons[name]) return icons[name].asString();
+  if (icons["default"]) return icons["default"].asString();
+  return name;
+}
