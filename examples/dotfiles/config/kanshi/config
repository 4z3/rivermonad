# kanshi: monitor configuration for river/rivermonad.
# Changes apply when kanshi starts (it is launched from ~/.config/river/init).
# Reload after editing:  pkill -x kanshi; setsid -f kanshi
#
# "output NAME" options:
#   mode WxH[@Hz]      resolution, e.g. mode 1920x1080@60
#   scale N            zoom: 1, 1.25, 1.5, 2 ... (fractional is fine)
#   position X,Y       placement when there are several monitors
#   enable / disable
#
# Each "profile" applies when exactly its monitors are connected.

profile vm {
    # No fixed "mode": the VM window can change size, and a mode that no
    # longer exists makes kanshi reject the whole profile. The preferred
    # (native) resolution is used instead.
    # Zoom: 2 is like macOS on Retina; higher = bigger, lower = more room.
    output Virtual-1 scale 2
}

