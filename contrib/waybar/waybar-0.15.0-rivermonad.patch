new file mode 100644
index 0000000..6dcb6f4
--- /dev/null
+++ b/include/modules/rivermonad/backend.hpp
@@ -0,0 +1,55 @@
+#pragma once
+
+#include <json/value.h>
+
+#include <list>
+#include <memory>
+#include <mutex>
+#include <string>
+
+#include "util/json.hpp"
+
+namespace waybar::modules::rivermonad {
+
+class EventHandler {
+ public:
+  virtual void onEvent() = 0;
+  virtual ~EventHandler() = default;
+};
+
+// Connection to rivermonad's IPC socket. It subscribes to the event stream
+// and keeps the latest state; it reconnects when rivermonad restarts.
+class IPC {
+ public:
+  IPC() { startIPC(); }
+
+  void registerForIPC(EventHandler* handler);
+  void unregisterForIPC(EventHandler* handler);
+
+  // Send one request on a new connection and return the reply.
+  static Json::Value send(const Json::Value& request);
+
+  // The data members are only safe to access while dataMutex_ is locked.
+  std::lock_guard<std::mutex> lockData() { return std::lock_guard(dataMutex_); }
+  const Json::Value& state() const { return state_; }
+  bool connected() const { return connected_; }
+
+ private:
+  void startIPC();
+  static std::string socketPath();
+  static int connectToSocket();
+  void setState(const Json::Value& state, bool connected);
+  void notify();
+
+  std::mutex dataMutex_;
+  Json::Value state_;
+  bool connected_ = false;
+
+  util::JsonParser parser_;
+  std::mutex callbackMutex_;
+  std::list<EventHandler*> callbacks_;
+};
+
+inline std::unique_ptr<IPC> gIPC;
+
+}  // namespace waybar::modules::rivermonad
