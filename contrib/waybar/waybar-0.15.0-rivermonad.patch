+++ b/src/modules/rivermonad/layout.cpp
@@ -0,0 +1,67 @@
+#include "modules/rivermonad/layout.hpp"
+
+#include <spdlog/spdlog.h>
+
+#include "util/sanitize_str.hpp"
+
+namespace waybar::modules::rivermonad {
+
+Layout::Layout(const std::string& id, const Bar& bar, const Json::Value& config)
+    : ALabel(config, "layout", id, "{}", 0, false, /*enable_click=*/true), bar_(bar) {
+  label_.hide();
+  if (!gIPC) gIPC = std::make_unique<IPC>();
+  gIPC->registerForIPC(this);
+  dp.emit();
+}
+
+Layout::~Layout() { gIPC->unregisterForIPC(this); }
+
+void Layout::onEvent() { dp.emit(); }
+
+void Layout::doUpdate() {
+  auto ipcLock = gIPC->lockData();
+  const auto& state = gIPC->state();
+
+  // Prefer the workspace on this output, fall back to the focused one.
+  Json::Value chosen;
+  for (const auto& ws : state["workspaces"]) {
+    if (!ws["output"].isNull() && ws["output"].asString() == bar_.output->name) chosen = ws;
+  }
+  if (chosen.isNull()) {
+    for (const auto& ws : state["workspaces"]) {
+      if (ws["focused"].asBool()) chosen = ws;
+    }
+  }
+
+  if (!gIPC->connected() || chosen.isNull()) {
+    label_.hide();
+    return;
+  }
+  const auto layout = chosen["layout"].asString();
+  label_.set_markup(fmt::format(fmt::runtime(format_), waybar::util::sanitize_string(layout),
+                                fmt::arg("layout", waybar::util::sanitize_string(layout)),
+                                fmt::arg("workspace", chosen["name"].asString())));
+  if (tooltipEnabled()) label_.set_tooltip_text(layout);
+  label_.show();
+}
+
+void Layout::update() {
+  doUpdate();
+  ALabel::update();
+}
+
+bool Layout::handleToggle(GdkEventButton* const& e) {
+  if (e->button == 1 && !config_["on-click"].isString()) {
+    try {
+      Json::Value request(Json::objectValue);
+      request["Action"] = "NextLayout";
+      IPC::send(request);
+    } catch (const std::exception& ex) {
+      spdlog::error("rivermonad: error changing layout: {}", ex.what());
+    }
+    return true;
+  }
+  return ALabel::handleToggle(e);
+}
+
+}  // namespace waybar::modules::rivermonad
diff --git a/src/modules/rivermonad/window.cpp b/src/modules/rivermonad/window.cpp
new file mode 100644
index 0000000..dcf3711
--- /dev/null
+++ b/src/modules/rivermonad/window.cpp
@@ -0,0 +1,70 @@
+#include "modules/rivermonad/window.hpp"
+
+#include <spdlog/spdlog.h>
+
+#include "util/rewrite_string.hpp"
+#include "util/sanitize_str.hpp"
+
+namespace waybar::modules::rivermonad {
+
+Window::Window(const std::string& id, const Bar& bar, const Json::Value& config)
+    : AAppIconLabel(config, "window", id, "{title}", 0, true), bar_(bar) {
+  if (!gIPC) gIPC = std::make_unique<IPC>();
+  gIPC->registerForIPC(this);
+  dp.emit();
+}
+
+Window::~Window() { gIPC->unregisterForIPC(this); }
+
+void Window::onEvent() { dp.emit(); }
+
+void Window::doUpdate() {
+  auto ipcLock = gIPC->lockData();
+  const auto& state = gIPC->state();
+
+  // With "separate-outputs", only the bar on the focused output shows it.
+  const bool otherOutput = config_["separate-outputs"].asBool() &&
+                           state["focused_output"].isString() &&
+                           state["focused_output"].asString() != bar_.output->name;
+
+  if (!gIPC->connected() || state["title"].isNull() || otherOutput) {
+    label_.hide();
+    updateAppIconName("", "");
+    setClass("empty", true);
+    if (!oldAppId_.empty()) setClass(oldAppId_, false);
+    oldAppId_.clear();
+    return;
+  }
+
+  const auto title = state["title"].asString();
+  const auto appId = state["app_id"].asString();
+  setClass("empty", false);
+  label_.show();
+  label_.set_markup(waybar::util::rewriteString(
+      fmt::format(fmt::runtime(format_), fmt::arg("title", waybar::util::sanitize_string(title)),
+                  fmt::arg("app_id", waybar::util::sanitize_string(appId))),
+      config_["rewrite"]));
+  updateAppIconName(appId, "");
+  if (tooltipEnabled()) label_.set_tooltip_text(title);
+
+  if (oldAppId_ != appId) {
+    if (!oldAppId_.empty()) setClass(oldAppId_, false);
+    if (!appId.empty()) setClass(appId, true);
+    oldAppId_ = appId;
+  }
+}
+
+void Window::update() {
+  doUpdate();
+  AAppIconLabel::update();
+}
+
+void Window::setClass(const std::string& className, bool enable) {
+  auto ctx = label_.get_style_context();
+  if (enable)
+    ctx->add_class(className);
+  else
+    ctx->remove_class(className);
+}
+
+}  // namespace waybar::modules::rivermonad
