diff --git a/src/modules/rivermonad/backend.cpp b/src/modules/rivermonad/backend.cpp
new file mode 100644
index 0000000..b8f9000
--- /dev/null
+++ b/src/modules/rivermonad/backend.cpp
@@ -0,0 +1,159 @@
+#include "modules/rivermonad/backend.hpp"
+
+#include <spdlog/spdlog.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <chrono>
+#include <cstring>
+#include <sstream>
+#include <thread>
+
+namespace waybar::modules::rivermonad {
+
+std::string IPC::socketPath() {
+  if (const char* env = getenv("RIVERMONAD_SOCKET"); env != nullptr && *env != '\0') return env;
+  const char* runtime = getenv("XDG_RUNTIME_DIR");
+  const char* display = getenv("WAYLAND_DISPLAY");
+  std::string disp = display != nullptr ? display : "wayland-0";
+  std::replace(disp.begin(), disp.end(), '/', '_');
+  return std::string(runtime != nullptr ? runtime : "/tmp") + "/rivermonad-" + disp + ".sock";
+}
+
+int IPC::connectToSocket() {
+  const auto path = socketPath();
+  int fd = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+  if (fd == -1) return -1;
+
+  struct sockaddr_un addr {};
+  addr.sun_family = AF_UNIX;
+  strncpy(addr.sun_path, path.c_str(), sizeof(addr.sun_path) - 1);
+  if (connect(fd, reinterpret_cast<struct sockaddr*>(&addr), sizeof(addr)) == -1) {
+    close(fd);
+    return -1;
+  }
+  return fd;
+}
+
+static bool writeAll(int fd, const std::string& data) {
+  size_t off = 0;
+  while (off < data.size()) {
+    ssize_t n = write(fd, data.data() + off, data.size() - off);
+    if (n <= 0) return false;
+    off += static_cast<size_t>(n);
+  }
+  return true;
+}
+
+// Reads newline-terminated lines from a socket.
+class LineReader {
+ public:
+  explicit LineReader(int fd) : fd_(fd) {}
+  bool next(std::string& line) {
+    for (;;) {
+      if (auto pos = buf_.find('\n'); pos != std::string::npos) {
+        line = buf_.substr(0, pos);
+        buf_.erase(0, pos + 1);
+        return true;
+      }
+      char chunk[4096];
+      ssize_t n = read(fd_, chunk, sizeof(chunk));
+      if (n <= 0) return false;
+      buf_.append(chunk, static_cast<size_t>(n));
+    }
+  }
+
+ private:
+  int fd_;
+  std::string buf_;
+};
+
+void IPC::startIPC() {
+  std::thread([this]() {
+    bool warned = false;
+    for (;;) {
+      int fd = connectToSocket();
+      if (fd == -1) {
+        if (!warned) {
+          spdlog::warn("rivermonad IPC: cannot connect to {}, retrying", socketPath());
+          warned = true;
+        }
+        std::this_thread::sleep_for(std::chrono::seconds(1));
+        continue;
+      }
+      warned = false;
+      spdlog::info("rivermonad IPC: connected");
+
+      LineReader reader(fd);
+      std::string line;
+      if (writeAll(fd, "\"EventStream\"\n") && reader.next(line) && line == R"({"Ok":"Handled"})") {
+        while (reader.next(line)) {
+          spdlog::debug("rivermonad IPC: received {}", line);
+          try {
+            const auto ev = parser_.parse(line);
+            if (ev.isMember("State")) setState(ev["State"], true);
+          } catch (const std::exception& e) {
+            spdlog::warn("rivermonad IPC: bad message {}: {}", line, e.what());
+          }
+        }
+      } else {
+        spdlog::error("rivermonad IPC: failed to start the event stream");
+      }
+      close(fd);
+
+      // rivermonad went away (restart or exit): show nothing until it is back.
+      setState(Json::Value(), false);
+      std::this_thread::sleep_for(std::chrono::milliseconds(300));
+    }
+  }).detach();
+}
+
+void IPC::setState(const Json::Value& state, bool connected) {
+  {
+    auto lock = lockData();
+    state_ = state;
+    connected_ = connected;
+  }
+  notify();
+}
+
+void IPC::notify() {
+  std::lock_guard lock(callbackMutex_);
+  for (auto* handler : callbacks_) handler->onEvent();
+}
+
+void IPC::registerForIPC(EventHandler* handler) {
+  if (handler == nullptr) return;
+  std::lock_guard lock(callbackMutex_);
+  callbacks_.push_back(handler);
+}
+
+void IPC::unregisterForIPC(EventHandler* handler) {
+  if (handler == nullptr) return;
+  std::lock_guard lock(callbackMutex_);
+  callbacks_.remove(handler);
+}
+
+Json::Value IPC::send(const Json::Value& request) {
+  int fd = connectToSocket();
+  if (fd == -1) throw std::runtime_error("rivermonad is not running");
+
+  Json::StreamWriterBuilder builder;
+  builder["indentation"] = "";
+  std::string payload = Json::writeString(builder, request) + "\n";
+
+  std::string line;
+  LineReader reader(fd);
+  bool ok = writeAll(fd, payload) && reader.next(line);
+  close(fd);
+  if (!ok) throw std::runtime_error("error talking to rivermonad");
+
+  Json::Value response;
+  std::istringstream iss(line);
+  iss >> response;
+  return response;
+}
+
+}  // namespace waybar::modules::rivermonad
diff --git a/src/modules/rivermonad/layout.cpp b/src/modules/rivermonad/layout.cpp
