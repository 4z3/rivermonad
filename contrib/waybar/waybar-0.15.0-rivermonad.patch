@@ -0,0 +1,98 @@
+waybar-rivermonad-workspaces(5)
+
+# NAME
+
+waybar - rivermonad workspaces, window and layout modules
+
+# DESCRIPTION
+
+Modules for the rivermonad window manager (an xmonad-style window manager for
+river). They read rivermonad's IPC socket ($RIVERMONAD_SOCKET, or
+$XDG_RUNTIME_DIR/rivermonad-$WAYLAND_DISPLAY.sock) and reconnect when
+rivermonad restarts.
+
+Like in xmonad, workspaces are not tied to outputs: every bar shows all of
+them, and the one shown on the bar's output gets the *active* class.
+
+# rivermonad/workspaces
+
+*format*: ++
+	typeof: string ++
+	default: {name} ++
+	Replacements: {name}, {icon}, {index}, {windows}, {layout}, {output}.
+
+*format-icons*: ++
+	typeof: object ++
+	Icons by state (*empty*, *focused*, *visible*), then by workspace name, then *default*.
+
+*hide-empty*: ++
+	typeof: bool ++
+	default: false ++
+	Hide workspaces without windows unless they are shown on some output.
+
+*show-extra*: ++
+	typeof: bool ++
+	default: false ++
+	Also show workspaces created at runtime (e.g. the scratchpad one).
+
+*current-only*: ++
+	typeof: bool ++
+	default: false ++
+	Only show the workspace on this bar's output.
+
+*click-action*: ++
+	typeof: string ++
+	default: focus ++
+	*focus* behaves like xmonad's view (a workspace shown on another output gets the focus there); *view* behaves like greedyView (bring it to the focused output).
+
+*disable-click*: ++
+	typeof: bool ++
+	default: false
+
+*disable-markup*: ++
+	typeof: bool ++
+	default: false
+
+# rivermonad/window
+
+*format*: ++
+	typeof: string ++
+	default: {title} ++
+	Replacements: {title}, {app_id}.
+
+*separate-outputs*: ++
+	typeof: bool ++
+	default: false ++
+	Only show the title on the bar of the focused output.
+
+*rewrite*: ++
+	typeof: object ++
+	Rules to rewrite the title, as in other window modules.
+
+# rivermonad/layout
+
+*format*: ++
+	typeof: string ++
+	default: {} ++
+	Replacements: {} or {layout}, {workspace}. A left click switches to the next layout unless *on-click* is set.
+
+# EXAMPLES
+
+```
+"rivermonad/workspaces": {
+	"format": "{name}",
+	"hide-empty": true
+},
+"rivermonad/window": { "max-length": 60 }
+```
+
+# STYLE
+
+- *#workspaces button*
+- *#workspaces button.focused*
+- *#workspaces button.active*
+- *#workspaces button.visible*
+- *#workspaces button.empty*
+- *#workspaces button#rivermonad-workspace-<name>*
+- *#window.empty*
+- *#layout*
